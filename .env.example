# Copy to .env and fill in real values. Never commit .env.

# OpenAI-compatible self-hosted judge endpoint (vLLM / SGLang)
JUDGECAL_SELFHOSTED_BASE_URL=http://localhost:8000/v1
JUDGECAL_SELFHOSTED_API_KEY=changeme

# Anthropic adapter (optional, add when you have a key)
ANTHROPIC_API_KEY=

# OpenAI adapter (optional, add when you have a key)
OPENAI_API_KEY=

# MLflow tracking (optional)
MLFLOW_TRACKING_URI=

# Langfuse tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
